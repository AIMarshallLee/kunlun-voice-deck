{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KunlunPong",
  "description": "心跳应答 (Bridge -> CoreS3)。",
  "type": "object",
  "required": ["type", "timestamp"],
  "properties": {
    "type": { "type": "string", "enum": ["pong"] },
    "timestamp": { "type": "integer", "description": "Bridge 侧毫秒级 Unix 时间戳" },
    "echo": { "type": "integer", "description": "原样返回 ping 中的 timestamp，便于设备计算 RTT" }
  },
  "additionalProperties": false
}

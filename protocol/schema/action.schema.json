{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KunlunActionRequest",
  "type": "object",
  "required": ["id", "type", "action", "payload"],
  "properties": {
    "id": {
      "type": "string",
      "description": "全局请求唯一标识"
    },
    "type": {
      "type": "string",
      "enum": ["action"]
    },
    "action": {
      "type": "string",
      "description": "Action Namespace, 例如 app.open, keyboard.shortcut, shell.run"
    },
    "payload": {
      "type": "object",
      "description": "Action 执行参数"
    },
    "timestamp": {
      "type": "integer",
      "description": "毫秒级 Unix 时间戳"
    }
  },
  "additionalProperties": false
}
